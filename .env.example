# Copy this file to .env.local and fill in the values on your own machine.
# Never commit .env.local. Never paste real values into chat, issues or code.

# The app connects as app_user (pooled). Migrations connect as migrator
# (direct). The login library connects as auth_service (pooled).
# scripts/set-db-passwords.ts fills these in.

# Development database (Neon project billing-dev).
DATABASE_URL_DEV=
MIGRATOR_DATABASE_URL_DEV=
AUTH_DATABASE_URL_DEV=

# Test database (Neon project billing-test), used by the tests.
DATABASE_URL_TEST=
MIGRATOR_DATABASE_URL_TEST=
AUTH_DATABASE_URL_TEST=

# Login library (Better Auth). `npm run auth:secret` fills these in.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# Email sending (Resend). Optional in development (without them, emails are
# saved in .dev-mailbox/); required in production. Never paste the key in chat.
RESEND_API_KEY=
EMAIL_FROM=
