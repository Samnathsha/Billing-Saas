{
  "name": "billing-saas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "start:offline-check": "next build && RESEND_API_KEY=re_local_check_not_a_key EMAIL_FROM=\"Local check <local@test.invalid>\" next start",
    "lint": "eslint --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:e2e": "playwright test",
    "test:flows": "playwright test --config playwright.flows.config.ts",
    "test:offline": "playwright test --config playwright.offline.config.ts",
    "prepare": "git config core.hooksPath .githooks || true",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:test": "DB_TARGET=test drizzle-kit migrate",
    "db:check": "drizzle-kit check",
    "test:db": "vitest run --project db",
    "test:perf": "vitest run --project perf",
    "db:check-rls": "tsx scripts/check-rls.ts test",
    "db:check-rls:dev": "tsx scripts/check-rls.ts dev",
    "dev:add-member": "tsx scripts/dev-add-member.ts",
    "audit:runtime": "tsx scripts/audit-runtime.ts",
    "stock:rebuild": "tsx scripts/rebuild-stock.ts",
    "auth:secret": "tsx scripts/auth-secret.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@better-auth/core": "^1.7.7",
    "@node-rs/argon2": "^2.2.1",
    "@sentry/nextjs": "^11.4.0",
    "@serwist/turbopack": "^9.5.13",
    "better-auth": "^1.7.7",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "dexie": "^4.4.6",
    "drizzle-orm": "^0.45.3",
    "fflate": "^0.8.3",
    "lucide-react": "^1.49.0",
    "next": "16.3.8",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.89.0",
    "server-only": "^0.0.1",
    "serwist": "^9.5.13",
    "sharp": "^0.35.5",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "fake-indexeddb": "^6.2.5",
    "fast-check": "^4.10.2",
    "shadcn": "^4.21.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
